# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Build outputs
build/
build_out/
*.so
*.egg-info/
dist/
*_pb2.py

# IDE
.idea/
.vscode/
*.swp

# Logs
amct_log/
*.log

# Coverage
.coverage
htmlcov/

# Misc
.DS_Store
*.bak
tmp/

# Local Claude state
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# Generated agent views (source of truth: .agents/).
# .claude is fully generated (skills/agents/hooks/settings.json + CLAUDE.md) -> ignore whole dir.
# .opencode keeps hand-maintained opencode.json + README.md tracked, so only its
# init-agent.sh-generated subdirs (skills/agents/docs) are ignored.
/.claude/
/.opencode/skills
/.opencode/agents
/.opencode/docs
/CLAUDE.md
