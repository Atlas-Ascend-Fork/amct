{
  "_comment": "Benchmark dataset registry, shared by prefetch_data.py (download) and bench_offline.py (offline read). Paths are relative to BENCH_ASSETS. splits map split name -> one path/glob or a list of paths/globs under <BENCH_ASSETS>/<subdir>/.",
  "mmlu_pro": {
    "repo_id": "TIGER-Lab/MMLU-Pro",
    "subdir": "mmlu_pro",
    "splits": {
      "test": "data/test-00000-of-00001.parquet",
      "validation": "data/validation-00000-of-00001.parquet"
    }
  },
  "math500": {
    "repo_id": "HuggingFaceH4/MATH-500",
    "subdir": "math500",
    "splits": {
      "test": [
        "test-*.parquet",
        "data/test-*.parquet",
        "**/test-*.parquet"
      ]
    }
  },
  "livecodebench": {
    "repo_id": "livecodebench/code_generation_lite",
    "subdir": "livecodebench_code_generation_lite",
    "dataset_name": "v6",
    "splits": {
      "test": [
        "test6.jsonl"
      ]
    },
    "allow_patterns": [
      "README.md",
      "code_generation_lite.py",
      "test6.jsonl"
    ]
  },
  "livecodebench_release_v6": {
    "repo_id": "livecodebench/code_generation_lite",
    "subdir": "livecodebench_code_generation_lite_release_v6",
    "dataset_name": "release_v6",
    "splits": {
      "test": [
        "test.jsonl",
        "test2.jsonl",
        "test3.jsonl",
        "test4.jsonl",
        "test5.jsonl",
        "test6.jsonl"
      ]
    },
    "allow_patterns": [
      "README.md",
      "code_generation_lite.py",
      "test.jsonl",
      "test2.jsonl",
      "test3.jsonl",
      "test4.jsonl",
      "test5.jsonl",
      "test6.jsonl"
    ]
  }
}
