{
  "_comment": "Benchmark dataset registry, shared by prefetch_data.py (download) and bench_offline.py (offline read). Paths are relative to BENCH_ASSETS. splits map split name -> one path/glob, a list of paths/globs, or {\"any_of\": [...]} / {\"all_of\": [...]} under <BENCH_ASSETS>/<subdir>/. any_of = alternative layouts of the SAME data, first hit wins (a cache holding two layouts is read once, not twice); all_of = shards that must ALL be merged (bare string/list also means all_of).",
  "mmlu_pro": {
    "repo_id": "TIGER-Lab/MMLU-Pro",
    "subdir": "mmlu_pro",
    "splits": {
      "test": "data/test-00000-of-00001.parquet",
      "validation": "data/validation-00000-of-00001.parquet"
    }
  },
  "math500": {
    "repo_id": "HuggingFaceH4/MATH-500",
    "subdir": "math500",
    "splits": {
      "test": {
        "any_of": [
          "test.jsonl",
          "data/test.jsonl",
          "test-*.parquet",
          "data/test-*.parquet",
          "**/test-*.parquet"
        ]
      }
    },
    "allow_patterns": [
      "*.parquet",
      "**/*.parquet",
      "*.jsonl",
      "**/*.jsonl",
      "README.md"
    ]
  },
  "livecodebench": {
    "repo_id": "livecodebench/code_generation_lite",
    "subdir": "livecodebench_code_generation_lite",
    "dataset_name": "v6",
    "splits": {
