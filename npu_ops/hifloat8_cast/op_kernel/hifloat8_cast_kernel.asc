#include "kernel_operator.h"
#include "hifloat8_cast_tiling.h"

// FP32/FP16/BF16 格式参数
constexpr uint32_t FP32_EXP_BITS = 8;
constexpr uint32_t FP32_FRAC_BITS = 23;
constexpr uint32_t FP32_EXP_BIAS = 127;

constexpr uint32_t FP16_EXP_BITS = 5;
constexpr uint32_t FP16_FRAC_BITS = 10;
constexpr uint32_t FP16_EXP_BIAS = 15;

constexpr uint32_t BF16_EXP_BITS = 8;
constexpr uint32_t BF16_FRAC_BITS = 7;
constexpr uint32_t BF16_EXP_BIAS = 127;

constexpr uint32_t HIF8_SIGN_SHIFT = 7;
constexpr uint32_t HIF8_DENORMAL_EXP_BIAS = 23;

constexpr uint32_t HIF8_DOT_TABLE[16] = {
    (0x00 << 24) | (3 << 16) | (0 << 8) | (0 << 4) | 7,
    (0x00 << 24) | (3 << 16) | (1 << 8) | (0 << 4) | 7,
    (0x08 << 24) | (3 << 16) | (3 << 8) | (1 << 4) | 7,
    (0x08 << 24) | (3 << 16) | (3 << 8) | (1 << 4) | 7,
    (0x18 << 24) | (3 << 16) | (4 << 8) | (2 << 4) | 7,
    (0x18 << 24) | (3 << 16) | (4 << 8) | (2 << 4) | 7,
    (0x18 << 24) | (3 << 16) | (4 << 8) | (2 << 4) | 7,
    (0x18 << 24) | (3 << 16) | (4 << 8) | (2 << 4) | 7,
    (0x1c << 24) | (2 << 16) | (4 << 8) | (3 << 4) | 3,
    (0x1c << 24) | (2 << 16) | (4 << 8) | (3 << 4) | 3,
    (0x1c << 24) | (2 << 16) | (4 << 8) | (3 << 4) | 3,
    (0x1c << 24) | (2 << 16) | (4 << 8) | (3 << 4) | 3,
    (0x1e << 24) | (1 << 16) | (4 << 8) | (4 << 4) | 1,
    (0x1e << 24) | (1 << 16) | (4 << 8) | (4 << 4) | 1,
    (0x1e << 24) | (1 << 16) | (4 << 8) | (4 << 4) | 1,
    (0x1e << 24) | (1 << 16) | (4 << 8) | (4 << 4) | 1,
};

__aicore__ inline void GetHif8BitsNum(int32_t expNoBias, uint32_t& dotValue, uint32_t& expBits, uint32_t& fracBits) {
    int32_t absExp = expNoBias < 0 ? -expNoBias : expNoBias;
    if (expNoBias == 0) { dotValue = 0x01; expBits = 0; fracBits = 3; }
    else if (absExp == 1) { dotValue = 0x02; expBits = 1; fracBits = 3; }
    else if (absExp >= 2 && absExp <= 3) { dotValue = 0x04; expBits = 2; fracBits = 3; }
    else if (absExp >= 4 && absExp <= 7) { dotValue = 0x08; expBits = 3; fracBits = 2; }
    else { dotValue = 0x0C; expBits = 4; fracBits = 1; }
}

// 编码函数：FP → HiFloat8 (通用版本)
__aicore__ inline uint8_t FpBitsToHiF8(uint32_t inData, uint32_t expBits, uint32_t fracBits, uint32_t expBias) {
    uint32_t totalBits = expBits + fracBits + 1;
    uint32_t sign = inData >> (totalBits - 1);
    uint32_t expMask = (1 << expBits) - 1;
    uint32_t fracMask = (1 << fracBits) - 1;
    
    uint32_t expFp = (inData >> fracBits) & expMask;
    uint32_t fracFp = inData & fracMask;
    
    uint32_t expMax = expMask;
    if (expFp == expMax && fracFp > 0) return 0x80;
    if (expFp == expMax && fracFp == 0) return (sign << HIF8_SIGN_SHIFT) | 0x6F;
    
    int32_t expNoBias = expFp - expBias;
    
    if (expNoBias < -22) return 0x00;
    if (expNoBias >= 15) return (sign << HIF8_SIGN_SHIFT) | 0x6E;
    
    if (expNoBias >= -22 && expNoBias < -15) {
        uint32_t fracHiF8 = (fracFp >> (fracBits - 1)) >= 1 
            ? HIF8_DENORMAL_EXP_BIAS + expNoBias + 1 
            : HIF8_DENORMAL_EXP_BIAS + expNoBias;
        return (sign << HIF8_SIGN_SHIFT) | fracHiF8;
    }
    
    uint32_t dotValue, expHiF8Bits, fracHiF8Bits;
    GetHif8BitsNum(expNoBias, dotValue, expHiF8Bits, fracHiF8Bits);
    
    uint32_t fracShift = fracBits - fracHiF8Bits - 1;
    uint32_t fractmp = fracShift < 32 ? (fracFp >> fracShift) : 0;
    uint32_t fracMax = (1 << (fracHiF8Bits + 1)) - 1;
    uint32_t fracHiF8 = 0;
    
    if (fractmp == fracMax) {
        expNoBias += 1;
        GetHif8BitsNum(expNoBias, dotValue, expHiF8Bits, fracHiF8Bits);
    } else if ((fractmp & 0x01) == 0x01) {
        fracHiF8 = (fractmp + 1) >> 1;
    } else {
        fracHiF8 = fractmp >> 1;
    }
    
    uint32_t signExp = expNoBias < 0 ? 1 : 0;
    
    if (dotValue == 1) {
        return (sign << HIF8_SIGN_SHIFT) | (dotValue << fracHiF8Bits) | fracHiF8;
    } else {
        int32_t absExp = expNoBias < 0 ? -expNoBias : expNoBias;
        uint32_t expHiF8 = absExp - (1 << (expHiF8Bits - 1));
        return (sign << HIF8_SIGN_SHIFT) | (dotValue << 3) 
            | (signExp << (expHiF8Bits + fracHiF8Bits - 1)) 
            | (expHiF8 << fracHiF8Bits) | fracHiF8;
    }
}

// 解码函数：HiFloat8 → FP (通用版本)
__aicore__ inline uint32_t HiF8ToFpBits(uint8_t inData, uint32_t expBits, uint32_t fracBits, uint32_t expBias) {
    if (inData == 0) return 0;
    
    uint32_t totalBits = expBits + fracBits + 1;
    uint32_t expMax = (1 << expBits) - 1;
    
    if (inData == 0x80) return (expMax << fracBits) | ((1 << fracBits) - 1);
    if (inData == 0x6F) return expMax << fracBits;
    if (inData == 0xEF) return (1 << (totalBits - 1)) | (expMax << fracBits);
    
    uint8_t dot = (inData & 0x78) >> 3;
    uint32_t info = HIF8_DOT_TABLE[dot];
    
    uint8_t expMask = (info >> 24) & 0xFF;
    uint8_t fracHiF8Bits = (info >> 16) & 0xFF;
    uint8_t expSignShift = (info >> 8) & 0xFF;
    uint8_t expHiF8Bits = (info >> 4) & 0x0F;
    uint8_t fracMask = info & 0x0F;
    
    uint32_t expHiF8 = (inData & expMask) >> fracHiF8Bits;
    uint32_t signExp = (inData >> expSignShift) & 0x01;
    uint32_t fracFpN = inData & fracMask;
    uint32_t expFpN;
    
    if (expSignShift == 0) {
        expFpN = expBias - (HIF8_DENORMAL_EXP_BIAS - fracFpN);
        fracFpN = 0;
    } else if (expSignShift == 1) {
        expFpN = expBias;
    } else {
        int32_t expNoBias = (expHiF8 | (1 << (expHiF8Bits - 1))) * (signExp == 1 ? -1 : 1);
        expFpN = expNoBias + expBias;
    }
    
    uint32_t sign = inData >> HIF8_SIGN_SHIFT;
    uint32_t fracShift = fracBits - fracHiF8Bits;
    return (sign << (totalBits - 1)) | (expFpN << fracBits) | (fracFpN << fracShift);
}

class KernelHiFloat8Cast {
public:
    __aicore__ inline KernelHiFloat8Cast(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output, const __gm__ HiFloat8CastTilingData* tiling) {
        this->tiling = tiling;
        castMode_ = tiling->castMode;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        
        if (blockIdx < tiling->blockNum - 1) total = tiling->numPerCore;
        else total = tiling->tailNumLastCore;
        
        tileNum = (total + TILE_LENGTH - 1) / TILE_LENGTH;
        tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        if (tailTileElementNum == 0 && tileNum > 0) { tileNum--; tailTileElementNum = TILE_LENGTH; }

        uint64_t offset = blockIdx * tiling->numPerCore;
        
        // 根据类型设置参数
        if (castMode_ == 0) { expBits_ = FP32_EXP_BITS; fracBits_ = FP32_FRAC_BITS; expBias_ = FP32_EXP_BIAS; inputBytes_ = 4; outputBytes_ = 1; }
        else if (castMode_ == 1) { expBits_ = FP16_EXP_BITS; fracBits_ = FP16_FRAC_BITS; expBias_ = FP16_EXP_BIAS; inputBytes_ = 2; outputBytes_ = 1; }
        else if (castMode_ == 2) { expBits_ = BF16_EXP_BITS; fracBits_ = BF16_FRAC_BITS; expBias_ = BF16_EXP_BIAS; inputBytes_ = 2; outputBytes_ = 1; }
        else if (castMode_ == 3) { expBits_ = FP32_EXP_BITS; fracBits_ = FP32_FRAC_BITS; expBias_ = FP32_EXP_BIAS; inputBytes_ = 1; outputBytes_ = 4; }
        else if (castMode_ == 4) { expBits_ = FP16_EXP_BITS; fracBits_ = FP16_FRAC_BITS; expBias_ = FP16_EXP_BIAS; inputBytes_ = 1; outputBytes_ = 2; }
        else if (castMode_ == 5) { expBits_ = BF16_EXP_BITS; fracBits_ = BF16_FRAC_BITS; expBias_ = BF16_EXP_BIAS; inputBytes_ = 1; outputBytes_ = 2; }
        
        inputGm.SetGlobalBuffer((__gm__ uint8_t*)input + offset * inputBytes_, total * inputBytes_);
        outputGm.SetGlobalBuffer((__gm__ uint8_t*)output + offset * outputBytes_, total * outputBytes_);
        
        pipe_->InitBuffer(inQueue, DOUBLE_BUFFER, TILE_LENGTH * 4);
        pipe_->InitBuffer(outQueue, DOUBLE_BUFFER, TILE_LENGTH * 4);
    }

    __aicore__ inline void Process() {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(i, count);
            Compute(count);
            CopyOut(i, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t tileIdx, uint32_t count) {
        uint32_t byteOffset = tileIdx * TILE_LENGTH * inputBytes_;
        uint32_t byteCount = count * inputBytes_;
        
        auto xLocal = inQueue.AllocTensor<uint8_t>();
        AscendC::DataCopy(xLocal, inputGm[byteOffset], byteCount);
        inQueue.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count) {
        auto xLocal = inQueue.DeQue<uint8_t>();
        auto yLocal = outQueue.AllocTensor<uint8_t>();
        
        if (castMode_ <= 2) {  // 编码
            if (inputBytes_ == 4) {
                auto xUint32 = xLocal.template ReinterpretCast<uint32_t>();
                for (uint32_t i = 0; i < count; i++) {
                    yLocal.SetValue(i, FpBitsToHiF8(xUint32.GetValue(i), expBits_, fracBits_, expBias_));
                }
            } else {
                auto xUint16 = xLocal.template ReinterpretCast<uint16_t>();
                for (uint32_t i = 0; i < count; i++) {
                    yLocal.SetValue(i, FpBitsToHiF8(xUint16.GetValue(i), expBits_, fracBits_, expBias_));
                }
            }
        } else {  // 解码
            if (outputBytes_ == 4) {
                auto yUint32 = yLocal.template ReinterpretCast<uint32_t>();
                for (uint32_t i = 0; i < count; i++) {
                    yUint32.SetValue(i, HiF8ToFpBits(xLocal.GetValue(i), expBits_, fracBits_, expBias_));
                }
            } else {
                auto yUint16 = yLocal.template ReinterpretCast<uint16_t>();
                for (uint32_t i = 0; i < count; i++) {
                    yUint16.SetValue(i, HiF8ToFpBits(xLocal.GetValue(i), expBits_, fracBits_, expBias_));
                }
            }
        }
        
        outQueue.EnQue(yLocal);
        inQueue.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t count) {
        uint32_t byteOffset = tileIdx * TILE_LENGTH * outputBytes_;
        uint32_t byteCount = count * outputBytes_;
        
        auto yLocal = outQueue.DeQue<uint8_t>();
        AscendC::DataCopy(outputGm[byteOffset], yLocal, byteCount);
        outQueue.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ HiFloat8CastTilingData* tiling;
    uint32_t castMode_;
    uint32_t expBits_;
    uint32_t fracBits_;
    uint32_t expBias_;
    uint32_t inputBytes_;
    uint32_t outputBytes_;
    
    AscendC::GlobalTensor<uint8_t> inputGm;
    AscendC::GlobalTensor<uint8_t> outputGm;
    
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    
    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

extern "C" __global__ __vector__ void hifloat8_cast_kernel(GM_ADDR input, GM_ADDR output, GM_ADDR tiling) {
    AscendC::TPipe pipe;
    KernelHiFloat8Cast op(&pipe);
    op.Init(input, output, (__gm__ HiFloat8CastTilingData*)tiling);
    op.Process();
}
